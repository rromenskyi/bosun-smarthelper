# Copy to .env and fill in real values. Loaded automatically at startup (godotenv).
# .env is gitignored — never commit real secrets.

# API key for the remote LLM provider. Name must match llm.remote.api_key_env
# in config.yaml (default: OPENAI_API_KEY).
OPENAI_API_KEY=sk-...

# Optional key for a local OpenAI-compatible server such as LM Studio.
# Leave llm.local.api_key_env empty when the local server requires no key.
LOCAL_LLM_API_KEY=local-key...

# Host path to the Hugging Face cache (where `-hf` downloads land), bind-mounted
# into the llama-chat/llama-embed containers so models aren't re-downloaded.
# Only used by docker-compose.yml's variable interpolation, not read by Bosun.
LLAMA_HF_CACHE=/home/youruser/.cache/huggingface

# Credentials for `smarthelper backup` (docs/backup.md) — any S3-compatible
# bucket (AWS S3, Backblaze B2, MinIO, Wasabi, ...), configured via
# backup.s3 in config.yaml. Only used when you actually run the command;
# nothing reads these otherwise.
# BACKUP_S3_ACCESS_KEY_ID=...
# BACKUP_S3_SECRET_ACCESS_KEY=...

# Telegram bot token for alerts.channels.telegram (docs/alerts.md) — create
# a bot with @BotFather, add it to the chat you want alerts in, and put
# that chat's numeric ID in config.yaml's alerts.channels.telegram.chat_id.
# Only used when a threshold or NOAA alert actually fires.
# ALERTS_TELEGRAM_BOT_TOKEN=...

# Starts the sandboxd service (docs/sandbox.md, run_code tool) — it holds
# /var/run/docker.sock (root-equivalent on this host), so it doesn't run
# just because sandbox.enabled: true is set in config.yaml; this is the
# second, infra-level switch. Uncomment only alongside sandbox.enabled.
# COMPOSE_PROFILES=sandbox

