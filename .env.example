# Copy to .env and fill in real values. Loaded automatically at startup (godotenv).
# .env is gitignored — never commit real secrets.

# API key for the remote LLM provider. Name must match llm.remote.api_key_env
# in config.yaml (default: OPENAI_API_KEY).
OPENAI_API_KEY=sk-...

# Optional key for a local OpenAI-compatible server such as LM Studio.
# Leave llm.local.api_key_env empty when the local server requires no key.
LOCAL_LLM_API_KEY=local-key...
