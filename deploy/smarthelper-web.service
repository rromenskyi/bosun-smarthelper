[Unit]
Description=Bosun (Starpom) LAN web interface
After=network-online.target llama-server.service
Wants=network-online.target llama-server.service

[Service]
Type=simple
User=roman220
WorkingDirectory=/home/roman220/bosun-smarthelper
ExecStart=/home/roman220/bosun-smarthelper/bin/smarthelper serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
