+
+// piper_synthesize_next returns one chunk per *sentence* — each is an
+// independent ONNX inference run over that sentence's own phoneme queue
+// entry (see piper.cpp's phoneme_id_queue) — with no guarantee either
+// end lands near zero amplitude. Concatenating them back-to-back (as
+// this function used to) produces an audible click at every sentence
+// boundary. A short silence gap, with a short linear fade into/out of
+// it on the neighboring chunks, turns that click into a natural pause.
+constexpr float kSentenceGapSeconds = 0.2F;
+constexpr float kFadeSeconds = 0.01F;
+
+// Ramps the given edge(s) of pcm linearly to/from silence so a chunk
+// boundary meets its neighboring silence gap smoothly instead of
+// jumping straight from whatever amplitude synthesis happened to end
+// (or start) on.
+void fadeEdges(std::vector<int16_t> &pcm, int sampleRate, bool fadeIn, bool fadeOut) {
+  std::size_t fadeSamples = std::min(
+      static_cast<std::size_t>(kFadeSeconds * sampleRate), pcm.size() / 2);
+  if (fadeSamples == 0) {
+    return;
+  }
+  if (fadeIn) {
+    for (std::size_t i = 0; i < fadeSamples; i++) {
+      float gain = static_cast<float>(i) / static_cast<float>(fadeSamples);
+      pcm[i] = static_cast<int16_t>(static_cast<float>(pcm[i]) * gain);
+    }
+  }
+  if (fadeOut) {
+    std::size_t total = pcm.size();
+    for (std::size_t i = 0; i < fadeSamples; i++) {
+      float gain = static_cast<float>(i) / static_cast<float>(fadeSamples);
+      pcm[total - 1 - i] = static_cast<int16_t>(static_cast<float>(pcm[total - 1 - i]) * gain);
+    }
+  }
+}
+
+void writeSilence(std::ostream &stream, int sampleRate) {
+  std::vector<int16_t> silence(static_cast<std::size_t>(kSentenceGapSeconds * sampleRate), 0);
+  stream.write(reinterpret_cast<const char *>(silence.data()),
+               // NOLINTNEXTLINE(bugprone-narrowing-conversions)
+               silence.size() * sizeof(int16_t));
+}
 } // namespace
 
