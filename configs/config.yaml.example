# Bosun (Starpom) configuration example
# Copy to ~/.config/smarthelper/config.yaml or ./config.yaml

# LLM Configuration
# Assistant identity and optional personality.
assistant:
  name_ru: "Старпом"
  name_en: "Bosun"
  style_prompt: ""                       # Example: Reply with light pirate flavor; stay clear and accurate.

llm:
  # Remote LLM (OpenAI-compatible API)
  remote:
    base_url: "https://api.openai.com/v1"  # OpenAI or compatible proxy
    model: "gpt-4o-mini"                    # Model name
    api_key_env: "OPENAI_API_KEY"           # Env var name for API key
    # organization: ""                      # Optional: OpenAI organization
    temperature: 0.8                       # Remote is robust enough at this to stay in-format;
                                            # higher keeps long roleplay from feeling repetitive
    # timeout: 30s                          # Request timeout
    max_retries: 5                         # Retry network, 429, and 5xx failures
    retry_backoff: 500ms                   # Exponential delay between attempts

  # Local LLM. These defaults match the llama-chat service docker-compose.yml
  # already builds and runs for you (deploy/llama/Dockerfile, port 1234,
  # OpenAI-compatible) — the Docker path (docs/docker.md) needs zero edits
  # here to get a fully working, fully offline local model. See INSTALL.md.
  local:
    base_url: "http://localhost:1234/v1"
    model: "default"                        # Matches llama-chat's --alias default
    api_format: "openai"                    # ollama, or openai for llama.cpp/LM Studio
    api_key_env: "LOCAL_LLM_API_KEY"        # Set in .env; llama-chat rejects requests without it
    # mradermacher/gemma-4-E2B-it-GGUF (docker-compose.yml's bundled model)
    # doesn't emit tool calls in the Qwen-style XML this app parses
    # natively — supports_tools: false switches to a model-agnostic
    # prompted-JSON fallback instead. Set true if you swap in a model
    # whose native tool-calling this app's parser understands.
    supports_tools: false
    temperature: 0.55                      # Lower than remote: a weak local model is already
                                            # shakier on tool-call format; less randomness helps
    stream: false                          # This model/build corrupts multi-byte UTF-8 (e.g.
                                            # Cyrillic) specifically in streaming mode, confirmed
                                            # absent in buffered mode — see docs/streaming.md.
                                            # Try true first if you swap in a different model.
    timeout: 300s                         # Weak hardware may need several minutes; at ~3-6 tok/s
                                           # a single long tool-using answer can take that long
    # Not using the bundled llama-chat? Point base_url/model/api_format at
    # Ollama instead, e.g.:
    #   base_url: "http://localhost:11434"
    #   model: "llama3.1:8b"                # must already be pulled: ollama pull llama3.1:8b
    #   api_format: "ollama"

  # Router settings
  router:
    check_interval: 30s                     # How often to check connectivity
    check_timeout: 5s                       # Timeout for connectivity check
    check_target: "https://api.openai.com"  # Target for online check
    prefer_remote: true                     # Use remote when online

  # OpenAI-compatible /embeddings endpoint for memo/document semantic
  # search (see docs/memo-search.md). Empty base_url (the default) disables
  # the feature: memos and documents still save fine, search just falls
  # back to plain substring matching. Matches the bundled llama-embed
  # service (port 1235) — comment out if you're not using Docker and have
  # no embeddings server of your own.
  embeddings:
    base_url: "http://localhost:1235/v1"
    model: "embed"
    timeout: 10s

# MCP Server Configuration
mcp:
  server_name: "bosun"                      # Server identifier
  transport: "stdio"                        # Transport: stdio (only supported)
  # log_level: "info"                       # debug, info, warn, error

# LAN-only web interface
web:
  bind: "127.0.0.1:8080"                   # For phone access, use an explicit private LAN IP,
                                             # or "0.0.0.0:8080" to survive the host's IP changing
                                             # (e.g. no DHCP reservation) — see docs/tls.md.
  request_timeout: 600s                     # Bounds the whole chat request (incl. tool calls);
                                             # keep well above llm.local.timeout for headroom
  default_language: "ru"                   # ru or en
  # Which budget applies to a given request is decided at request time from
  # current connectivity (see docs/token-budget.md), so a chat that switches
  # between local and remote mid-session doesn't lose history either way —
  # only the local turn's outgoing request is trimmed down; storage always
  # keeps up to the (larger) remote budget.
  history:
    local:
      turns: 4                              # Kept small: local is a weak fallback model
      max_chars: 4000                       # ~1000 tokens
    remote:
      turns: 40                             # Remote context is comparatively unlimited
      max_chars: 60000                      # ~15000 tokens; still bounded so a session can't grow forever
  session_ttl: 24h                          # Session expiration (persisted sessions too)
  max_sessions: 100                         # Evict the oldest session above this limit
  # session_store_path: ""                  # Empty uses ~/.local/share/bosun/sessions.json.
                                             # Persists chat history across a page reload and a
                                             # service restart; set to a bind mount path etc. if needed.
  # settings_store_path: ""                 # Empty uses ~/.local/share/bosun/settings.json. Seeds
                                             # from assistant.*, llm.*.temperature, web.default_language,
                                             # and memo.canonical_tags above on first run only — after
                                             # that the web UI's settings page (gear icon) is the
                                             # source of truth and edits there persist live without a
                                             # restart. See docs/settings.md.
  # tls_cert_file: ""                       # Both empty (the default) serves plain HTTP. Set both to
  # tls_key_file: ""                        # serve HTTPS — e.g. a cert/key pair from mkcert, which a
                                             # phone/laptop can be made to trust with no browser warning
                                             # even though this is a private LAN IP, not a public domain.
                                             # See docs/tls.md. If you own a real domain, a real
                                             # Let's Encrypt cert via DNS-01 needs no per-device trust
                                             # at all — see docs/cloudflare.md instead.
  # ca_cert_file: ""                        # Optional: path to the CA's public cert (mkcert's
                                             # rootCA.pem — never its rootCA-key.pem) so a new device
                                             # can download and trust it at GET /ca.pem, linked from the
                                             # settings page, instead of a separate file transfer.
  # http_fallback_bind: ""                  # Optional, only used when TLS is enabled above: also
                                             # serve plain HTTP (same handler) on this address, for a
                                             # device that can't be made to trust the TLS cert at all
                                             # (e.g. a corporate MDM-managed phone that blocks
                                             # installing custom root certs). See docs/tls.md.

# Early, TTS-only voice interface (see docs/voice.md) — a "speak" button
# on each assistant chat bubble. Empty model_path (the default) disables
# it entirely; the web UI's speak button just does nothing if clicked.
# voice:
#   tts:
#     binary_path: "/usr/local/bin/piper_exe"  # patched to emit 16-bit PCM WAV —
#                                               # see deploy/piper/wav-pcm16.patch
#     model_path: "/opt/bosun/models/tts/ru_RU-<voice>-medium.onnx"
#     espeak_data_path: "/opt/bosun/espeak-ng-data"
#   stt:
#     base_url: "http://127.0.0.1:1236"        # a running whisper-server —
                                                # see docker-compose.yml's whisper-stt
                                                # service and docs/voice.md
#     language: "ru"

# Persistent local memos. Empty path uses ~/.local/share/bosun/memos.json.
memo:
  path: ""
  # Free-form tags (written by the model at write time — see
  # docs/memo-search.md) can be auto-mapped onto this fixed list in the
  # background, purely additive, whenever no chat request is in flight.
  # Empty (the default) disables background tag normalization entirely —
  # tags/list/search's tag filter still work against the free-form tags.
  # canonical_tags: ["purchases", "fuel_system", "oil", "engine", "electrical", "maintenance"]
  # tag_normalize_interval: 5m
  # min_search_relevance: 0.4               # Cosine similarity floor (roughly -1 to 1) below which a
                                             # memo/document search hit is dropped before it ever
                                             # reaches the LLM — a weak match is noise, not an answer.
                                             # 0 (or below) disables filtering. See docs/memo-search.md.
  # attach_image_min_relevance: 0.6         # Separate, higher threshold for `smarthelper documents
                                             # attach-images` (documents.Store.AttachOrphanedImages) —
                                             # a so-so search result is low-stakes, but permanently
                                             # merging an image onto the wrong chunk across two
                                             # unrelated documents isn't safe at the same bar as
                                             # min_search_relevance. See docs/memo-search.md.
  # metric_merge_check_interval: 24h        # How often the background pass looks for equipment-upkeep
                                             # counters that might be the same physical counter under two
                                             # different names (see maintenance's known_metrics). Only ever
                                             # proposes a merge for a human to approve/reject in the web
                                             # UI — nothing renames automatically. See
                                             # docs/maintenance-tracking.md.

# Uploaded reference documents (manuals, how-tos) for semantic search —
# uploaded only via the web UI, never an LLM-callable action. Empty path
# uses ~/.local/share/bosun/documents.json. See docs/memo-search.md.
documents:
  path: ""

# Failure log for tool/LLM errors, reviewed later to drive fixes — not a
# general-purpose logger. Empty path uses ~/.local/share/bosun/errors.jsonl.
# Inspect with `smarthelper errors`.
error_log:
  path: ""

# Public, keyless tools hidden automatically in offline mode.
online_tools:
  duckduckgo_url: "https://html.duckduckgo.com/html/"
  wikipedia_url: "https://{lang}.wikipedia.org/api/rest_v1/page/summary/{title}"
  request_timeout: 10s

# Geocoding for get_directions (Google/Apple Maps links). Hidden automatically
# offline like the other online tools above.
maps:
  geocoding_url: "https://geocoding-api.open-meteo.com/v1/search"
  nominatim_url: "https://nominatim.openstreetmap.org/search"
  timeout: 8s

# Sensor Configuration
sensors:
  # Outdoor weather sensor
  weather:
    type: "mock"                            # mock or open_meteo
    # For mock type:
    mock_temp_c: 22.5
    mock_humidity: 60
    # For mqtt type:
    # mqtt_topic: "home/weather/outdoor"
    # mqtt_broker: "tcp://localhost:1883"
    # For http type:
    # http_url: "http://weather-station.local/api"
    # For Open-Meteo (no API key required):
    # type: "open_meteo"
    # default_location: "Denver"             # Used when the tool receives no location
    # geocoding_url: "https://geocoding-api.open-meteo.com/v1/search"
    # nominatim_url: "https://nominatim.openstreetmap.org/search" # Landmark fallback
    # forecast_url: "https://api.open-meteo.com/v1/forecast"
    # timeout: 8s

  # Refrigerator temperature
  fridge:
    type: "mock"
    mock_fridge_c: 4.0
    mock_freezer_c: -18.0
    # mqtt_topic: "home/fridge/temp"

  # GPS / Location
  gps:
    type: "mock"
    mock_latitude: 40.7608                   # Salt Lake City
    mock_longitude: -111.8910
    mock_speed_kmh: 0
    mock_altitude_m: 150
    # For a real GPS receiver over USB/serial (NMEA 0183 — GPRMC + GPGGA,
    # tested against a u-blox 7 module; see internal/tools/gps_serial.go):
    # type: "serial"
    # serial_port: "/dev/ttyACM0"            # or the stable path from
                                              # `ls /dev/serial/by-id/` if
                                              # you have more than one USB
                                              # serial device
    # baud_rate: 9600                        # u-blox NMEA default
    # In Docker, also bind-mount the device node and add the host's
    # "dialout" group's GID — see docker-compose.yml's "bosun" service.

  # System metrics
  system:
    type: "native"                          # native (uses gopsutil)
    # include: ["cpu", "memory", "disk", "network"]

# Local monitoring dashboard — a personal, bounded-history analog to
# MRTG/Grafana (internal/metrics, docs/monitoring.md). Samples CPU/memory/
# disk/GPS/fridge on an interval, stores them in a local SQLite file, and
# charts them from a button in the web UI.
metrics:
  enabled: true
  interval: "30s"                          # How often to sample
  retention_days: 30                       # Older samples are pruned automatically
  # store_path: ""                         # Empty uses metrics.DefaultPath()
                                            # (~/.local/share/bosun/metrics.db)
  # "sources" is data, not code — what to sample, from where, and how to
  # parse it. Defaults to every sensor this project ships with (see
  # internal/config's setDefaults); uncomment to see/override that list, or
  # just append a new entry once a new sensor tool exists (e.g. a future
  # battery/water-tank tool) without touching any Go code:
  # sources:
  #   - metric: cpu_temp_c                 # name stored/queried under
  #     tool: get_system_info              # a registered tool (internal/tools.Registry)
  #     args: { include: ["cpu"] }         # passed to the tool's Execute as-is
  #     field: cpu.temp_c                  # dot path into the tool's result, e.g. "memory.used_percent"
  #     label_ru: "Температура CPU"        # shown in the dashboard's metric picker
  #     label_en: "CPU temperature"
  #     unit: "°C"
  #   - metric: cpu_percent
  #     tool: get_system_info
  #     args: { include: ["cpu"] }
  #     field: cpu.used_percent
  #     label_ru: "Загрузка CPU"
  #     label_en: "CPU load"
  #     unit: "%"
  #   # Once a battery tool exists, adding it here is the entire integration:
  #   - metric: battery_percent
  #     tool: get_battery
  #     field: percent
  #     label_ru: "Заряд"
  #     label_en: "Charge"
  #     unit: "%"

# Backup (`smarthelper backup`) to any S3-compatible bucket — AWS S3,
# Backblaze B2, MinIO, Wasabi, .... Manual by default (only runs when you
# type the command or click "back up now"); the settings page has an
# opt-in toggle for an automatic interval-based schedule instead. See
# docs/backup.md.
# backup:
#   data_dir: ""                            # Empty uses the same default as memo.path/documents.path.
                                             # Docker: set this to /home/bosun/.local/share/bosun (the
                                             # container's own path, not ./data/bosun on the host) and run
                                             # `docker compose exec bosun smarthelper backup` — see docs/backup.md.
#   s3:
#     endpoint: "https://s3.us-west-002.backblazeb2.com"  # any S3-compatible endpoint
#     region: "us-west-002"                 # some providers require a real region; others accept anything non-empty
#     bucket: "bosun-backups"
#     access_key_id_env: "BACKUP_S3_ACCESS_KEY_ID"         # set in .env
#     secret_access_key_env: "BACKUP_S3_SECRET_ACCESS_KEY" # set in .env

# Alerts — "something is wrong enough a human should hear about it right
# now": NOAA weather alerts for the current position, and any
# metrics.sources metric crossing a configured threshold. Each channel
# below only fires once it's also turned on from the settings page (off by
# default there, same split as backup's auto-schedule). See docs/alerts.md.
# alerts:
#   noaa:
#     use_gps: true                # re-checks the get_gps tool's position on every tick — the
#                                   # right choice for anything that moves. Set latitude/longitude
#                                   # instead for a fixed position and leave use_gps out.
#     # latitude: 42.35
#     # longitude: -71.05
#     check_interval: "15m"
#   thresholds:
#     - metric: disk_used_percent  # any metrics.sources metric — a future tank-level or
#       operator: ">"              # battery-charge sensor needs only a new metrics.sources entry
#       value: 90                  # and a new threshold here, no code change.
#       title: "Disk space"
#     # - metric: battery_percent
#     #   operator: "<"
#     #   value: 20
#     #   title: "Battery charge"
#   channels:
#     telegram:
#       bot_token_env: "ALERTS_TELEGRAM_BOT_TOKEN"  # set in .env
#       chat_id: "123456789"
#     webhook:
#       url: "https://example.com/bosun-alerts"
#     speaker:
#       enabled: true               # needs /dev/snd passed through to the container and aplay
#       player_path: "aplay"        # installed — see docs/alerts.md — and voice.tts configured

# run_code: lets the LLM write and run a short Python 3 program for math/
# parsing/simulation it would otherwise reason about badly. Runs in a
# separate, isolated container via a separate `sandboxd` service, never
# inside bosun itself — see docs/sandbox.md before turning this on.
# Enabling it is genuinely TWO switches, not one: `enabled: true` here,
# AND `COMPOSE_PROFILES=sandbox` in .env (sandboxd holds
# /var/run/docker.sock — root-equivalent on the host — so it only runs at
# all once you opt into that separately).
# sandbox:
#   enabled: true
#   url: "http://127.0.0.1:8090"            # sandboxd's address, as bosun's tool sees it
#   session_ttl: "15m"                      # idle workspace containers are reaped after this long
#   timeout_seconds: 30                     # per-execution wall-clock cap (reliability, not security)
#   memory_limit: "512m"                    # per-container `docker run --memory` (reliability, not security)
#   cpu_limit: "1"                          # per-container `docker run --cpus` (reliability, not security)
#   # listen_addr/scratch_dir/state_dir are sandboxd-side only — the
#   # defaults (127.0.0.1:8090, /data/sandbox/workspaces, /data/sandbox/state)
#   # already match docker-compose.yml's sandboxd volume mounts; no reason
#   # to override them on a Docker deployment.

# Cameras — a 📹 button in the web UI for live view + archive, see
# docs/cameras.md. Config-only, not settings-page-editable: which cameras
# exist is an infrastructure decision. Each camera's own web server
# typically accepts only one client — internal/cameras.Relay is the one
# thing that ever connects to stream_url directly; the archive recorder
# and any number of live browser viewers are all subscribers of the
# relay instead, never the camera.
# cameras:
#   - name: "front"                          # url-safe id, used in API paths and the archive directory
#     label_ru: "Нос"
#     label_en: "Bow"
#     stream_url: "http://192.168.1.50:81/stream"
#     record: true                           # cyclic (ring-buffer) archival via ffmpeg — off just shows live view
#     segment_seconds: 300                   # 5-minute segments...
#     segment_count: 50                      # ...50 of them = ~4 hours on disk before the oldest is overwritten

# Logging
logging:
  level: "info"                             # debug, info, warn, error
  format: "text"                            # text, json
  output: "stderr"                          # stderr, stdout, file
  # file_path: "/var/log/smarthelper.log"
